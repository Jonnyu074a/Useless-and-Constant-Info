{
	"geode": "5.11.2",
	"gd": { "win": "2.2081", "android": "2.2081" },
	"id": "jonnyuun.advanced-info-overlay",
	"name": "Useless And Constant info",
	"version": "v5.3.0",
	"developer": "jonnyuun",
	"description": "Customizable real-time HUD for Geometry Dash. Shows FPS, CPS, accuracy, level info, time, session, mod menus and more. Open settings from the HUD button next to the Daily Chest.",
	"repository": "https://github.com/jonnyuun/Useless-and-Constant-Info",
	"issues": {
		"info": "Found a bug or have a suggestion? Open an issue on GitHub.",
		"url": "https://github.com/jonnyuun/Useless-and-Constant-Info/issues"
	},
	"tags": ["interface", "utility", "customization", "gameplay"],
	"settings": {
		"enabled":               { "type": "bool",   "name": "Enable Overlay",        "default": true },
		"position-mode":         { "type": "string", "name": "Position",              "default": "Bottom-Right",
		                           "one-of": ["Top-Left","Top-Right","Bottom-Left","Bottom-Right","Top-Center","Bottom-Center"] },
		"offset-x":              { "type": "int",    "name": "Offset X",              "default": 5,    "min": -2000, "max": 2000 },
		"offset-y":              { "type": "int",    "name": "Offset Y",              "default": 5,    "min": -2000, "max": 2000 },
		"font-type":             { "type": "string", "name": "Font",                  "default": "chatFont.fnt",
		                           "one-of": ["chatFont.fnt","goldFont.fnt","bigFont.fnt","gjFont01.fnt"] },
		"text-scale":            { "type": "float",  "name": "Text Scale",            "default": 0.45, "min": 0.2, "max": 1.2,
		                           "control": { "slider": true, "step": 0.05 } },
		"text-color":            { "type": "color",  "name": "Text Color",            "default": "#FFFFFF" },
		"text-opacity":          { "type": "int",    "name": "Text Opacity",          "default": 255, "min": 0, "max": 255,
		                           "control": { "slider": true } },
		"show-bg":               { "type": "bool",   "name": "Show Background",       "default": true },
		"bg-color":              { "type": "color",  "name": "Background Color",      "default": "#000000" },
		"bg-opacity":            { "type": "int",    "name": "Background Opacity",    "default": 130, "min": 0, "max": 255,
		                           "control": { "slider": true } },
		"bg-padding":            { "type": "int",    "name": "Background Padding",    "default": 8,   "min": 0, "max": 30,
		                           "control": { "slider": true } },
		"update-rate":           { "type": "float",  "name": "Update Rate (s)",       "default": 0.25,"min": 0.05,"max": 2.0,
		                           "control": { "slider": true, "step": 0.05 } },
		"hide-on-enter-level":   { "type": "bool",   "name": "Hide on Enter Level",   "default": false },
		"hide-on-exit-level":    { "type": "bool",   "name": "Hide on Exit Level",    "default": false },
		"color-coding":          { "type": "bool",   "name": "FPS Color Coding",      "default": false },
		"layout-mode":           { "type": "string", "name": "Layout",                "default": "Horizontal",
		                           "one-of": ["Horizontal","Vertical"] },
		"separator":             { "type": "string", "name": "Separator",             "default": " | " },
		"format-string":         { "type": "string", "name": "Format String",
		                           "default": "{fps} | {gd} | {geode} | {mods} | {os} | {user} | {mh} | {date} | {time} | {session} | {session_total} | {lvl} | {lvlid} | {att} | {best} | {progress} | {practice} | {cps} | {accuracy} | {deaths}" },

		"fps-show-fps":          { "type": "bool",   "name": "FPS: Show FPS",         "default": true },
		"fps-show-tps":          { "type": "bool",   "name": "FPS: Show TPS",         "default": true },
		"fps-show-together":     { "type": "bool",   "name": "FPS: Show as 60/60",    "default": true },
		"fps-show-target":       { "type": "bool",   "name": "FPS: Show Target Hz",   "default": false },

		"cps-enabled":           { "type": "bool",   "name": "CPS: Enable",           "default": true },

		"accuracy-enabled":      { "type": "bool",   "name": "Accuracy: Enable",      "default": true },
		"accuracy-require-noclip":{ "type": "bool",  "name": "Accuracy: Only with Noclip","default": false },

		"deaths-show":           { "type": "bool",   "name": "Deaths: Show",          "default": true },
		"deaths-show-session":   { "type": "bool",   "name": "Deaths: Session only",  "default": true },

		"mods-only-active":      { "type": "bool",   "name": "Mods: Only Active",     "default": false },

		"os-show-bits":          { "type": "bool",   "name": "OS: Show 32/64 bits",   "default": false },
		"os-android-override":   { "type": "int",    "name": "OS: Android Override",  "default": 0, "min": 0, "max": 2 },

		"user-show-name":        { "type": "bool",   "name": "User: Show Name",       "default": true },

		"date-format":           { "type": "int",    "name": "Date: Format (0-2)",    "default": 0, "min": 0, "max": 2 },

		"time-24h":              { "type": "bool",   "name": "Time: 24h",             "default": true },
		"time-show-seconds":     { "type": "bool",   "name": "Time: Show Seconds",    "default": true },

		"session-show-seconds":  { "type": "bool",   "name": "Session: Show Seconds", "default": true },

		"lvl-show-author":       { "type": "bool",   "name": "Level: Show Author",    "default": true }
	}
}
